<Page x:Class="Tb16p.Ui.Pages.SettingsPage"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:loc="clr-namespace:Tb16p.Ui.Localization">
    <StackPanel Margin="24,4,24,24" MaxWidth="1100">

        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Appearance}" Margin="2,8,0,8" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="LocalLanguage24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Language}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_Language_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="200" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Title" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DarkTheme24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Theme}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_Theme_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox MinWidth="200" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" DisplayMemberPath="Title" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Behaviour}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Power24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Startup}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_Startup_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding StartWithWindows}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="ArrowMinimize24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_CloseToTray}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_CloseToTray_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding CloseToTray}" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{loc:Tr Settings_Advanced}" />
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Timer24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_ReapplyLimits}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_ReapplyLimits_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox Width="130" Minimum="1" Maximum="60" SmallChange="1" MaxDecimalPlaces="0"
                          Value="{Binding ReapplyLimitsSeconds, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Timer24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_ReapplyCo}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_ReapplyCo_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:NumberBox Width="130" Minimum="5" Maximum="600" SmallChange="5" MaxDecimalPlaces="0"
                          Value="{Binding ReapplyCurveOptimizerSeconds, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="False" />
        </ui:CardControl>
        <ui:CardControl Margin="0,0,0,4">
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="DocumentTable24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_SensorLog}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{loc:Tr Settings_SensorLog_Desc}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch IsChecked="{Binding SensorLog}" />
        </ui:CardControl>
        <ui:CardControl>
            <ui:CardControl.Icon>
                <ui:SymbolIcon Symbol="Folder24" />
            </ui:CardControl.Icon>
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="{loc:Tr Settings_Files}" />
                    <TextBlock Style="{StaticResource CardDescription}" Text="{Binding DataFolder}" />
                </StackPanel>
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="{loc:Tr Settings_ViewLog}" Command="{Binding OpenLogCommand}" Margin="0,0,8,0" />
                <ui:Button Content="{loc:Tr Settings_OpenFolder}" Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>
        </ui:CardControl>
    </StackPanel>
</Page>
