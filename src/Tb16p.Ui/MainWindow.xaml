<ui:FluentWindow x:Class="Tb16p.Ui.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:loc="clr-namespace:Tb16p.Ui.Localization"
                 xmlns:pages="clr-namespace:Tb16p.Ui.Pages"
                 Title="TB16P Tuner"
                 Width="1200" Height="800" MinWidth="980" MinHeight="640"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="TB16P Tuner" />

        <ui:NavigationView x:Name="Navigation" Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="210"
                           FrameMargin="0">
            <ui:NavigationView.Header>
                <!-- Live status, the same on every page. -->
                <Border DataContext="{Binding Header}" Margin="24,4,24,4" Padding="14,10" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="16" Margin="0,0,6,0"
                                               Visibility="{Binding OnBattery, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                <ui:SymbolIcon Symbol="Battery524" FontSize="16" Margin="0,0,6,0"
                                               Visibility="{Binding OnBattery, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding PowerText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <ui:SymbolIcon Symbol="Gauge24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <ui:SymbolIcon x:Name="StatusIcon" Symbol="CheckmarkCircle24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock x:Name="StatusText" Text="{Binding StatusText}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding StatusText}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                <ui:SymbolIcon x:Name="FanIcon" Symbol="WeatherSqualls24" FontSize="16" Margin="0,0,6,0" />
                                <TextBlock x:Name="FanText" Text="{Binding FanText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel.Resources>
                                <Style x:Key="Label" TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Setter Property="Margin" Value="14,0,5,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                                <Style x:Key="Value" TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Style="{StaticResource Label}" Text="CPU" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Cpu}" />
                            <TextBlock Style="{StaticResource Label}" Text="CB1" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Cb1}" />
                            <TextBlock Style="{StaticResource Label}" Text="CB5" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Cb5}" />
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Sensor_Fan1}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Fan1}" />
                            <TextBlock Style="{StaticResource Label}" Text="{loc:Tr Sensor_Fan2}" />
                            <TextBlock Style="{StaticResource Value}" Text="{Binding Fan2}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </ui:NavigationView.Header>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_General}" TargetPageType="{x:Type pages:GeneralPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Profiles}" TargetPageType="{x:Type pages:ProfilesPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="DataHistogram24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{loc:Tr Nav_Support}" TargetPageType="{x:Type pages:SupportPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Heart24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
