<Application x:Class="Tb16p.Ui.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:Tb16p.Ui"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter x:Key="InverseBool" />
            <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <local:TextToVisibilityConverter x:Key="TextToVisibility" />

            <!-- Section title above a group of cards. -->
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="2,18,0,8" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            </Style>

            <Style x:Key="CardDescription" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A selectable card: a RadioButton drawn as a card with an accent border when checked. -->
            <Style x:Key="ChoiceCard" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <!-- Not based on the library's RadioButton style, so the theme text colour must be set here. -->
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" Padding="16,14" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="18" Height="18" Margin="0,1,12,0" VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring" StrokeThickness="1.5" Stroke="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" Visibility="Collapsed" />
                                    </Grid>
                                    <ContentPresenter Grid.Column="1" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                    <Setter TargetName="Ring" Property="Fill" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
